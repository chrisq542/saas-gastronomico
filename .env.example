# ========================================================
# FAST-FOOD SAAS - ENVIRONMENT CONFIGURATION TEMPLATE
# Duplica este archivo como .env o .env.local para desarrollo local
# ========================================================

# --------------------------------------------------------
# SUPABASE CONFIGURATION
# Obtén estas credenciales desde: https://supabase.com/dashboard/project/<PROJECT_ID>/settings/api
# --------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-DO-NOT-EXPOSE-TO-CLIENT..."

# --------------------------------------------------------
# PRISMA & POSTGRESQL CONNECTION STRINGS (SUPABASE)
# Obtén estas URLs en Supabase Dashboard -> Settings -> Database -> Connection String
# --------------------------------------------------------
# DATABASE_URL: Modo Connection Pooling (Transaction Mode - puerto 6543) con pgbouncer=true
# Utilizado por la aplicación Next.js / Serverless en producción y desarrollo
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Conexión directa a PostgreSQL (Session Mode - puerto 5432)
# Utilizado exclusivamente por Prisma para migraciones (npx prisma db push / migrate)
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# --------------------------------------------------------
# RESTAURANT / TENANT DEFAULTS
# Configuración del local comercial para tickets, WhatsApp y marca
# --------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_RESTAURANT_NAME="Burger & Fries Fast SaaS"
NEXT_PUBLIC_RESTAURANT_SLUG="burger-fries"
NEXT_PUBLIC_RESTAURANT_RUT="76.543.210-K"
NEXT_PUBLIC_RESTAURANT_ADDRESS="Av. Providencia 1234, Local 4, Santiago"
# Teléfono oficial del restaurante con código de país (sin '+' ni espacios, ej: 56912345678)
NEXT_PUBLIC_RESTAURANT_PHONE="56912345678"
NEXT_PUBLIC_RESTAURANT_WHATSAPP="56912345678"

# --------------------------------------------------------
# BUSINESS LOGIC & LOCALIZATION
# --------------------------------------------------------
NEXT_PUBLIC_CURRENCY_SYMBOL="$"
NEXT_PUBLIC_CURRENCY_CODE="CLP"
NEXT_PUBLIC_DEFAULT_DELIVERY_FEE="2000"
NEXT_PUBLIC_ESTIMATED_PREPARATION_TIME_MIN="25"
